<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Editar</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='styles.css') }}">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>

<main class="page-center">

    <div class="list-card">

        <a href="/" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <h1>Editar atividades</h1>

        {% if tarefas|length == 0 %}

            <p class="empty-msg">
                Nada marcado até o momento.
            </p>

        {% else %}

            {% for tarefa in tarefas %}

            <div class="task-card">

                <h2>{{ tarefa.nome }}</h2>

                <p>
                    <strong>Matéria:</strong>
                    {{ tarefa.matéria }}
                </p>

                <p>
                    <strong>Nota:</strong>
                    {{ tarefa.nota }}
                </p>

                <p>
                    <strong>Prazo:</strong>
                    {{ tarefa.prazo }}
                </p>

                <button class="edit-btn"
                        onclick="toggleEdit({{ tarefa.id }})">

                    <i class="fa-solid fa-pen"></i>

                </button>

                <form class="edit-form"
                      id="edit-{{ tarefa.id }}"
                      action="/editar"
                      method="POST">

                    <input type="hidden"
                           name="id"
                           value="{{ tarefa.id }}">

                    <label>Nome</label>

                    <input type="text"
                           name="nome"
                           value="{{ tarefa.nome }}"
                           required>

                    <label>Matéria</label>

                    <input type="text"
                           name="materia"
                           value="{{ tarefa.matéria }}"
                           required>

                    <label>Nota</label>

                    <input type="number"
                           name="nota"
                           value="{{ tarefa.nota }}"
                           min="0"
                           max="100"
                           required>

                    <label>Prazo</label>

                    <input type="date"
                           name="prazo"
                           value="{{ tarefa.prazo }}"
                           required>

                    <div class="button-group">

                        <button type="submit"
                                class="save-btn">

                            Salvar

                        </button>

                        <button type="button"
                                class="cancel-btn"
                                onclick="toggleEdit({{ tarefa.id }})">

                            Cancelar

                        </button>

                    </div>

                </form>

            </div>

            {% endfor %}

        {% endif %}

    </div>

</main>

<script src="{{ url_for('static', filename='script.js') }}"></script>

</body>
</html>